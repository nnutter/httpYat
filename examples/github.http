@base = https://api.github.com
@owner = AnWeber
@repo = httpyac
@username = AnWeber

### Get repository
# @name getRepo
GET {{base}}/repos/{{owner}}/{{repo}}
Accept: application/vnd.github+json
X-GitHub-Api-Version: 2022-11-28

### List open issues
# @name listIssues
GET {{base}}/repos/{{owner}}/{{repo}}/issues?state=open&per_page=5
Accept: application/vnd.github+json
X-GitHub-Api-Version: 2022-11-28

### Get user
# @name getUser
GET {{base}}/users/{{username}}
Accept: application/vnd.github+json
X-GitHub-Api-Version: 2022-11-28

### Check rate limit
# @name rateLimit
GET {{base}}/rate_limit
Accept: application/vnd.github+json
